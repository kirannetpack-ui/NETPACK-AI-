{
  "appId": "com.netpack.courier.ai",
  "appName": "COURIER with NETPACK",
  "webDir": "native-shell",
  "server": {
    "url": "https://netpack-ai.vercel.app",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "netpack-ai.vercel.app"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#142B3A",
      "androidSplashResourceName": "netpack_splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#FFFFFF"
    },
    "Keyboard": {
      "resize": "body",
      "style": "LIGHT",
      "resizeOnFullScreen": true
    }
  }
}

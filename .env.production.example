APP_NAME="COURIER with NETPACK"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-courier-domain.example
# Generate a unique key on the target deployment; never use the published demo key.
APP_KEY=
FORCE_HTTPS=true
APP_TIMEZONE=Asia/Kathmandu

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Configure TLS to your database where required by the hosting environment.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_DRIVER=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Private durable uploads are required on ephemeral/serverless hosts.
FILESYSTEM_DISK=private
PRIVATE_FILESYSTEM_DRIVER=s3
PRIVATE_AWS_ACCESS_KEY_ID=
PRIVATE_AWS_SECRET_ACCESS_KEY=
PRIVATE_AWS_DEFAULT_REGION=
PRIVATE_AWS_BUCKET=
PRIVATE_AWS_ENDPOINT=
PRIVATE_AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="NETPACK Operations"

ALLOW_DEMO_SEEDING=false
# Keep live payment switches off until merchant sandbox acceptance is complete.
KHALTI_LIVE=false
KHALTI_SECRET_KEY=
ESEWA_LIVE=false
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
DHL_WEBHOOK_SECRET=
FEDEX_WEBHOOK_SECRET=
UPS_WEBHOOK_SECRET=
ARAMEX_WEBHOOK_SECRET=
ROYAL_MAIL_WEBHOOK_SECRET=
AUSTRALIA_POST_WEBHOOK_SECRET=
DPD_WEBHOOK_SECRET=
AI_PROVIDER=builtin

APP_NAME="COURIER with NETPACK"

# Remote-area integrations remain disabled until official carrier credentials
# and approved API documentation are configured.
UPS_REMOTE_AREA_ENABLED=false
FEDEX_REMOTE_AREA_ENABLED=false
DHL_REMOTE_AREA_ENABLED=false
ARAMEX_REMOTE_AREA_ENABLED=false
DPD_REMOTE_AREA_ENABLED=false
TEAM_GLOBAL_REMOTE_AREA_ENABLED=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://netpack-final.test
APP_TIMEZONE=Asia/Kathmandu

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netpack_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Local development: use Mailpit. For a Gmail pilot, use smtp.gmail.com:587,
# your Gmail address, and a Google app password (never your normal password).
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="app.netpack@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production transactional email (recommended): configure a verified domain
# and select a supported provider such as Postmark or Amazon SES.
POSTMARK_TOKEN=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap2

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# NETPACK AI Logistics Copilot & Global AI Providers
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

KHALTI_LIVE=false
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
ESEWA_LIVE=false
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
SERPAPI_KEY=

# Live rider tracking. For production traffic, configure a commercial or
# self-hosted tile provider and include the attribution required by its terms.
TRACKING_LIVE_REFRESH_SECONDS=15
TRACKING_LIVE_STALE_AFTER_SECONDS=120
TRACKING_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
TRACKING_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Demo seed data is blocked in production unless explicitly enabled.
ALLOW_DEMO_SEEDING=false

# Production requires a unique APP_KEY and HTTPS. Local development can use HTTP.
FORCE_HTTPS=false
# NETPACK signed relay callbacks: independent secrets of at least 32 characters.
# Unconfigured carrier webhooks are disabled (503), never accepted unsigned.
DHL_WEBHOOK_SECRET=
FEDEX_WEBHOOK_SECRET=
UPS_WEBHOOK_SECRET=
ARAMEX_WEBHOOK_SECRET=
ROYAL_MAIL_WEBHOOK_SECRET=
AUSTRALIA_POST_WEBHOOK_SECRET=
DPD_WEBHOOK_SECRET=
